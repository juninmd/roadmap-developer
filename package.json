{
  "name": "roadmap-developer-2026",
  "version": "1.0.4",
  "description": "Guia para desenvolvedores completo e atualizado para 2026. Transformado em site estático com VitePress.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "lint": "eslint .",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .vitepress/dist --ignore playwright-report --ignore test-results",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "roadmap",
    "developer",
    "2026",
    "backend",
    "frontend",
    "mobile",
    "devops",
    "ai",
    "learning-path"
  ],
  "author": "Roadmap Developer Community",
  "license": "MIT",
  "dependencies": {
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/mocker": "^5.1.0",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "markdownlint-cli": "^0.50.0",
    "mermaid": "12.3.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  }
}
